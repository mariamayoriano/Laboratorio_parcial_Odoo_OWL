<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="mi_componente_owl.TodoList">
        <div class="o_todo_list p-4">
            <h2 class="mb-4">Lista de Tareas (OWL)</h2>

            <div class="input-group mb-3">
                <input type="text" class="form-control"
                       placeholder="Nueva tarea..."
                       t-att-value="state.newTask"
                       t-on-input="onInputChange"
                       t-on-keyup="onKeyup"/>
                <button class="btn btn-primary" t-on-click="addTask">
                    Agregar
                </button>
            </div>

            <ul class="list-group">
                <t t-foreach="state.tasks" t-as="task" t-key="task.id">
                    <li class="list-group-item d-flex justify-content-between">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input"
                                   t-att-checked="task.done"
                                   t-on-change="() => this.toggleTask(task.id)"/>
                            <label t-att-class="task.done ? 'text-decoration-line-through text-muted' : ''"
                                   t-esc="task.text"/>
                        </div>

                        <button class="btn btn-sm btn-outline-danger"
                                t-on-click="() => this.removeTask(task.id)">
                            ✕
                        </button>
                    </li>
                </t>
            </ul>

            <p class="mt-3 text-muted" t-if="state.tasks.length === 0">
                No hay tareas. ¡Agrega una!
            </p>
        </div>
    </t>
</templates>